# PostgreSQL connection string (Render, Neon, Supabase, or any managed Postgres)
DATABASE_URL="postgresql://user:password@host:5432/foodbridge?schema=public"

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Port the server listens on (Render sets this automatically in production)
PORT=3000

# "production" enables secure cookies; leave unset for local development
NODE_ENV=development
