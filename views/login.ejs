<%- include('partials/header') %>

<section class="form-page">
  <h1>Sign in</h1>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>
  <form method="POST" action="/login" class="stacked-form">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= form.email || '' %>" required />

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required />

    <button type="submit" class="button-link">Sign in</button>
  </form>
  <p>No account yet? <a href="/register">Create one</a>.</p>
</section>

<%- include('partials/footer') %>
