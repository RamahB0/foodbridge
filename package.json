{
  "name": "foodbridge",
  "version": "1.0.0",
  "description": "Surplus food donation matching for small local donors and nonprofits.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "connect-pg-simple": "10.0.0",
    "dotenv": "16.4.5",
    "ejs": "3.1.10",
    "express": "4.21.0",
    "express-session": "1.18.0",
    "pg": "8.13.0"
  },
  "devDependencies": {
    "eslint": "9.11.1",
    "prisma": "5.20.0"
  }
}
